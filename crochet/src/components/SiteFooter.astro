---
import siteConfig from '../../site.config.json';

const [wordmarkStart, wordmarkEnd] = siteConfig.brand.wordmark.split('&');
---
<footer class="site-footer">
  <a class="wordmark footer-wordmark" href="/">{wordmarkStart}<span>&amp;</span>{wordmarkEnd}</a>
  <p>Thoughtful crochet, made by hand.</p>
  <nav aria-label="Footer navigation">
    <a href="/shop/">Shop</a>
    <a href="/about/">Our story</a>
    <a href="/contact/">Contact</a>
    <a href={`mailto:${siteConfig.brand.contactEmail}`}>Email us</a>
    <a href="/privacy/">Privacy</a>
  </nav>
  <p class="copyright">&copy; {new Date().getFullYear()} {siteConfig.brand.name}</p>
</footer>
