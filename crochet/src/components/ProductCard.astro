---
import type { CollectionEntry } from 'astro:content';
import siteConfig from '../../site.config.json';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const inquiryHref = `/custom-orders/?piece=${encodeURIComponent(product.id)}`;
const image = siteConfig.assets.products[product.id as keyof typeof siteConfig.assets.products];
---
<article class="product-card reveal" data-category={product.data.category} data-reveal>
  <a class="product-image-link" href={`/shop/${product.id}/`} aria-label={`View ${product.data.title}`}>
    <img src={image.src} alt={image.alt} loading="lazy" decoding="async" transition:name={`product-image-${product.id}`}>
    <span class="product-index">{product.data.number}</span>
    <span class="image-cta" aria-hidden="true">View this piece &#8599;</span>
  </a>
  <div class="product-meta">
    <div>
      <h3><a href={`/shop/${product.id}/`}>{product.data.title}</a></h3>
      <p>{product.data.shortDescription}</p>
      <a class="product-ask" href={inquiryHref}>Ask about this piece &#8599;</a>
    </div>
    <span class="product-type">{product.data.category === 'wear' ? 'WEAR' : 'HOME'}</span>
  </div>
</article>
