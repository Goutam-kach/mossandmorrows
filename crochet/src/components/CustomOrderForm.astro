---
import type { CollectionEntry } from 'astro:content';
import siteConfig from '../../site.config.json';

interface Props {
  products: CollectionEntry<'products'>[];
}

const { products } = Astro.props;
const formspreeId = siteConfig.formspree.formId.trim();
const formspreeEndpoint = formspreeId ? `https://formspree.io/f/${formspreeId}` : '';
---
<form
  class="order-form"
  id="order-form"
  action={formspreeEndpoint || `mailto:${siteConfig.brand.contactEmail}`}
  method="POST"
  enctype={formspreeEndpoint ? undefined : 'text/plain'}
  data-formspree-endpoint={formspreeEndpoint}
  data-contact-email={siteConfig.brand.contactEmail}
>
  <input type="hidden" name="_subject" value={`${siteConfig.brand.name} custom crochet enquiry`}>
  <div class="form-row">
    <label for="name">Your name</label>
    <input id="name" name="name" autocomplete="name" placeholder="Name" required>
  </div>
  <div class="form-row">
    <label for="email">Email address</label>
    <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
  </div>
  <div class="form-row">
    <label for="piece">What are you imagining?</label>
    <select id="piece" name="piece" required>
      <option value="" disabled selected>Choose a starting point</option>
      {products.map((product) => <option value={product.id}>{product.data.title}</option>)}
      <option value="something-else">Something else entirely</option>
    </select>
  </div>
  <div class="form-row">
    <label for="details">A few details <span>(colors, size, occasion)</span></label>
    <textarea id="details" name="details" rows="3" placeholder="Tell us a little about it..." required></textarea>
  </div>
  <button class="button button-dark" type="submit">Send your note <span aria-hidden="true">&#8599;</span></button>
  <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
  <p class="form-smallprint">{formspreeEndpoint ? 'Your note will be sent directly to the studio.' : 'Until Formspree is connected, your email app will open with the note ready to send.'}</p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#order-form');
  const productSelect = document.querySelector<HTMLSelectElement>('#piece');
  const formStatus = document.querySelector<HTMLElement>('#form-status');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const requestedPiece = new URLSearchParams(window.location.search).get('piece');
  if (requestedPiece && productSelect?.querySelector(`option[value="${CSS.escape(requestedPiece)}"]`)) {
    productSelect.value = requestedPiece;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const selectedPiece = productSelect?.selectedOptions[0]?.textContent ?? '';
    const endpoint = form.dataset.formspreeEndpoint;
    if (endpoint) {
      if (submitButton) submitButton.disabled = true;
      if (formStatus) formStatus.textContent = 'Sending your note...';
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error('Formspree request failed');
        form.reset();
        if (formStatus) formStatus.textContent = 'Thank you. Your note has been sent to the studio.';
      } catch {
        if (formStatus) formStatus.textContent = 'Your note could not be sent. Please try again or email the studio.';
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
      return;
    }

    const subject = `Custom crochet enquiry: ${selectedPiece}`;
    const body = [
      `Name: ${data.get('name')}`,
      `Email: ${data.get('email')}`,
      `Piece: ${selectedPiece}`,
      '',
      'Details:',
      data.get('details'),
    ].join('\n');
    if (formStatus) formStatus.textContent = 'Opening your email app with your note ready to send.';
    window.location.href = `mailto:${form.dataset.contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
