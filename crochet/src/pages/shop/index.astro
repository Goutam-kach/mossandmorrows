---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.number.localeCompare(b.data.number));
---
<SiteLayout title="Shop the collection" description="Browse small-batch crochet pieces for home and everyday wear." canonicalPath="/shop/">
  <div class="page-intro section-wrap">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Shop' }]} />
    <p class="eyebrow"><span class="eyebrow-mark"></span> Thoughtfully made, one piece at a time</p>
    <h1>The collection</h1>
    <p>Useful little things, with room for your own kind of color.</p>
  </div>
  <ProductGallery products={products} title="Find your favorite" />
</SiteLayout>
