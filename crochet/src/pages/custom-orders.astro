---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CustomOrderForm from '../components/CustomOrderForm.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const products = await getCollection('products');
---
<SiteLayout title="Custom crochet orders" description="Tell us about the crochet piece you have in mind. Every custom order starts with a conversation." canonicalPath="/custom-orders/">
  <section class="custom-page section-wrap" data-reveal>
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Custom orders' }]} />
    <div class="custom">
      <div class="custom-heading">
        <p class="eyebrow"><span class="eyebrow-mark"></span> Made around you</p>
        <h1>Have a little<br><em>something in mind?</em></h1>
        <p>Tell us what you’re dreaming up. We’ll take it one stitch at a time.</p>
        <div class="custom-note"><span class="note-dot"></span> Commissions are open for the season</div>
      </div>
      <CustomOrderForm products={products} />
    </div>
  </section>
  <section class="order-notes section-wrap" aria-labelledby="order-notes-title" data-reveal>
    <p class="eyebrow"><span class="eyebrow-mark"></span> Before we begin</p>
    <h2 id="order-notes-title">A few good things<br>to know.</h2>
    <div class="order-faq">
      <details>
        <summary>What happens after I send a note?</summary>
        <p>We’ll follow up to talk through the idea, materials, and details before anything is made.</p>
      </details>
      <details>
        <summary>Can I request a different color or size?</summary>
        <p>Share your preferences in the form. We’ll confirm what is possible with you before starting.</p>
      </details>
      <details>
        <summary>When will my piece be ready?</summary>
        <p>Timing depends on the piece and current studio schedule. We’ll agree on an estimate before your order is confirmed.</p>
      </details>
    </div>
  </section>
</SiteLayout>
