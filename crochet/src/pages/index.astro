---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductGallery from '../components/ProductGallery.astro';
import siteConfig from '../../site.config.json';

const products = (await getCollection('products'))
  .filter((product) => product.data.featured)
  .sort((a, b) => a.data.number.localeCompare(b.data.number));
---
<SiteLayout
  title={siteConfig.brand.tagline}
  description={siteConfig.brand.description}
  canonicalPath="/"
>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <img class="hero-image" src={siteConfig.assets.hero.src} alt={siteConfig.assets.hero.alt} fetchpriority="high">
    <div class="hero-shade"></div>
    <div class="hero-content">
      <p class="eyebrow light-eyebrow"><span class="eyebrow-mark"></span> The slow-made crochet studio</p>
      <h1 id="hero-title">Morrow<br>&amp; Moss</h1>
      <p class="hero-copy">Soft things for everyday living.<br>Made by hand, and made to stay.</p>
      <a class="button button-light" href="#collection">Explore the collection <span aria-hidden="true">&#8595;</span></a>
    </div>
    <p class="hero-caption">Made slowly in small batches <span>01 / 03</span></p>
  </section>

  <section class="intro section-wrap" aria-labelledby="intro-title">
    <p class="eyebrow"><span class="eyebrow-mark"></span> A softer kind of everyday</p>
    <h2 id="intro-title">A little more <em>human.</em><br>A little less hurry.</h2>
    <p class="intro-note">Every piece begins with a simple thing: good yarn, a patient hand, and the pleasure of making something useful.</p>
  </section>

  <ProductGallery products={products} />

  <section class="story" id="story" aria-labelledby="story-title">
    <div class="story-image-wrap">
      <img src={siteConfig.assets.story.src} alt={siteConfig.assets.story.alt} loading="lazy" decoding="async">
      <span class="story-stamp">made<br>slowly</span>
    </div>
    <div class="story-copy">
      <p class="eyebrow"><span class="eyebrow-mark"></span> A note from the maker</p>
      <h2 id="story-title">The good things<br>take <em>their time.</em></h2>
      <p>There is something lovely about making at the pace of your own hands. {siteConfig.brand.name} is a small crochet studio creating thoughtful pieces for home, for wearing, and for gifting.</p>
      <p>No rush, no two exactly alike. Just good yarn, careful stitches, and a little joy tucked into the everyday.</p>
      <a class="text-link" href="/about/">A little about the studio <span aria-hidden="true">&#8599;</span></a>
    </div>
  </section>

  <section class="custom section-wrap" aria-labelledby="custom-title">
    <div class="custom-heading">
      <p class="eyebrow"><span class="eyebrow-mark"></span> Made around you</p>
      <h2 id="custom-title">Have a little<br><em>something in mind?</em></h2>
      <p>Tell us what you’re dreaming up. We’ll take it one stitch at a time.</p>
      <div class="custom-note"><span class="note-dot"></span> Commissions are open for the season</div>
    </div>
    <div>
      <p class="intro-note">A favorite piece, a different color, or an idea all your own. Every custom order starts with a conversation.</p>
      <a class="button button-dark" href="/custom-orders/">Start a custom order <span aria-hidden="true">&#8599;</span></a>
    </div>
  </section>

  <section class="closing-band" aria-label="Morrow and Moss studio note">
    <p>Soft things. Slow days. <span>Good stitches.</span></p>
    <a href="#top">Back to the beginning &#8593;</a>
  </section>
</SiteLayout>
