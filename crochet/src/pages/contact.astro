---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import siteConfig from '../../site.config.json';
---
<SiteLayout title="Contact the studio" description={`Questions about a crochet piece or custom order? Get in touch with ${siteConfig.brand.name}.`} canonicalPath="/contact/">
  <section class="contact-page section-wrap">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
    <p class="eyebrow"><span class="eyebrow-mark"></span> A note is always welcome</p>
    <h1>Let's talk<br><em>about the good stuff.</em></h1>
    <p>For a custom idea, a product question, or anything else, send a note to the studio.</p>
    <a class="button button-dark" href={`mailto:${siteConfig.brand.contactEmail}`}>Email the studio <span aria-hidden="true">&#8599;</span></a>
    <p class="form-smallprint">Replace this sample address before publishing.</p>
  </section>
</SiteLayout>
